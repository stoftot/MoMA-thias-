@page "/join"
@using MoMA_thias.web.Model
@inherits JoinGameBase
@rendermode InteractiveServer

<div class="container py-4">
    <h2 class="mb-3">Join a Game</h2>

    @if (!Started)
    {
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Game code</label>
                <input class="form-control" @bind="Code" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Display name</label>
                <input class="form-control" @bind="DisplayName" />
            </div>
        </div>
        @if (StartError is not null)
        {
            <div class="text-danger mt-2">@StartError</div>
        }
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="Start">Start</button>
            <a class="btn btn-outline-secondary ms-2" href="/">Cancel</a>
        </div>
    }
    else if (CurrentArt is null)
    {
        <div class="alert alert-info">
            <strong>Please wait for the game master to select a new art work</strong> 🎉
        </div>
    }
    else if (!BidSubmitted)
    {
        <div class="mb-3">
            <label class="form-label">Item @CurrentArt.Name — your guess</label>
            <input class="form-control" type="number" step="1" min="0"
                   @bind="CurrentValueString" @bind:event="oninput" />
            @if (ValidationError is not null)
            {
                <div class="text-danger mt-1">@ValidationError</div>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="SubmitBid">Submit bid</button>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Thanks for the bid, please wait for the game master to switch to a new art work</strong> 🎉
        </div>
        <a class="btn btn-outline-dark" href="/">Home</a>
    }
</div>