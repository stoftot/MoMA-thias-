@page "/join"
@inherits JoinGameBase
@rendermode InteractiveServer

<div class="container py-4">
    <h2 class="mb-3">Join a Game</h2>

    @if (!Started)
    {
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Game code</label>
                <input class="form-control" @bind="Code" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Display name</label>
                <input class="form-control" @bind="DisplayName" />
            </div>
        </div>
        @if (StartError is not null)
        {
            <div class="text-danger mt-2">@StartError</div>
        }
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="Start">Start</button>
            <a class="btn btn-outline-secondary ms-2" href="/">Cancel</a>
        </div>
    }
    else if (!Finished)
    {
        <div class="mb-3">
            <label class="form-label">Item @CurrentIndexDisplay of 10 — your guess</label>
            <input class="form-control" type="number" step="0.01" min="0"
                   @bind="CurrentValueString" @bind:event="oninput" />
            @if (ValidationError is not null)
            {
                <div class="text-danger mt-1">@ValidationError</div>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Prev" disabled="@IsFirst">Back</button>
            @if (!IsLast)
            {
                <button class="btn btn-primary" @onclick="Next">Next</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="Finish">Finish</button>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Thank you for playing</strong> 🎉
        </div>
        <a class="btn btn-outline-dark" href="/">Home</a>
    }
</div>