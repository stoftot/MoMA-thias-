@page "/create"
@inherits CreateGameBase
@rendermode InteractiveServer

<div class="container py-4">
    <h2 class="mb-3">Create a game</h2>

    @if (!Created)
    {
        <div class="mb-3">
            <label class="form-label">Item @CurrentIndexDisplay of 10 — real price</label>
            <input class="form-control" type="number" step="0.01" min="0"
                   @bind="CurrentValueString" @bind:event="oninput" />
            @if (ValidationError is not null)
            {
                <div class="text-danger mt-1">@ValidationError</div>
            }
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Prev" disabled="@IsFirst">Back</button>
            @if (!IsLast)
            {
                <button class="btn btn-primary" @onclick="Next">Next</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="Finish">Finish</button>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <strong>Game ready!</strong> Share this code with players:
            <span class="badge text-bg-primary ms-2 fs-6">@Game!.GameCode</span>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-success" href="/join">Join this game</a>
            <a class="btn btn-secondary" href="/control">View leaderboard</a>
            <a class="btn btn-outline-dark" href="/">Home</a>
        </div>
    }
</div>