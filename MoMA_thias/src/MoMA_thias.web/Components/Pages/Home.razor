@page "/"

<div class="container py-5">
    <h1 class="mb-4">🎯 MoMAThias Price Guess Game</h1>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Create a Game</h5>
                    <p class="card-text">Set the 10 real prices and get a game code.</p>
                    <a href="create" class="btn btn-primary">Create</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Join a Game</h5>
                    <p class="card-text">Enter the code and your display name to play.</p>
                    <a href="join" class="btn btn-success">Join</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Control a Game</h5>
                    <p class="card-text">Enter a code to view the leaderboard.</p>
                    <a href="control" class="btn btn-secondary">Control</a>
                </div>
            </div>
        </div>
    </div>
</div>